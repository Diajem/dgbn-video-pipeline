{
  "name": "dgbn-video-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "video-studio/remotion"
  ],
  "scripts": {
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:sample": "node scripts/validate-manifest.mjs jobs/samples/dgbn-2026-08-05-evening.json",
    "produce": "node scripts/produce.mjs",
    "remotion:studio": "npm --workspace @dgbn/remotion-studio run studio",
    "render:bulletin": "npm --workspace @dgbn/remotion-studio run render:bulletin",
    "render:flash": "npm --workspace @dgbn/remotion-studio run render:flash",
    "render:card": "npm --workspace @dgbn/remotion-studio run render:card",
    "hyperframes:doctor": "npx hyperframes doctor",
    "hyperframes:preview": "cd video-studio/hyperframes && npx hyperframes preview",
    "hyperframes:skills": "npx skills add heygen-com/hyperframes --full-depth",
    "prepare:presenters": "node scripts/prepare-presenters.mjs",
    "avatar:musetalk:source:peet": "node scripts/prepare-musetalk-source.mjs peet",
    "avatar:musetalk:preflight": "node scripts/musetalk-preflight.mjs",
    "avatar:musetalk:benchmark:peet": "node scripts/run-musetalk-benchmark.mjs peet",
    "avatar:runpod:peet": "node scripts/runpod-musetalk-client.mjs peet"
  }
}
