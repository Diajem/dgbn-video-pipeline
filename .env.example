# Folder containing private extracted presenter packs. Keep those files outside this public repo.
PRESENTER_PACKS_ROOT=C:\DGBN\presenter-packs

# MuseTalk should be installed outside this public repo.
MUSE_TALK_HOME=C:\AI\MuseTalk
